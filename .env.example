# --- Gateway de execucao (sandbox | nuinvest | btg) ---
B3_BROKER_GATEWAY=sandbox

# --- Dados de mercado (planos gratuitos) ---
BRAPI_API_KEY=
HGBRASIL_API_KEY=
B3_QUOTE_CACHE_TTL=30

# --- Sandbox ---
B3_SANDBOX_IGNORE_SESSIONS=1

# --- Corretoras reais (quando onboarding estiver pronto) ---
NUINVEST_BASE_URL=https://openapi.nuinvest.com.br
NUINVEST_BEARER_TOKEN=
BTG_BASE_URL=https://api.br.btg.com
BTG_CLIENT_ID=
BTG_CLIENT_SECRET=

# --- Sessoes (defaults em config/b3_config.py; ex. override) ---
# B3_SESSION_equity_regular=10:00,16:55

# --- OpenAlgo core ---
MASTER_CONTRACT_CUTOFF_TIME=00:00

# --- Corretora fantasma (paper trading) ---
# B3_BROKER_GATEWAY=sandbox com as flags abaixo vira ambiente de operacao simulado:
# B3_SANDBOX_STATE_FILE=ghost_state.json   # estado persistido (sobrevive a restarts)
# B3_SANDBOX_LIVE_FILLS=1                  # fills MARKET a cotacao real (Brapi/HG)
# B3_SANDBOX_AUTO_TICK=30                  # motor de ticks a cada 30s: executa LIMIT/SL sozinho
# B3_SANDBOX_INITIAL_CASH=100000            # caixa inicial
